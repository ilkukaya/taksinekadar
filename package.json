{
  "name": "taksinekadar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Türkiye taksi ücreti hesaplama ve taksi durakları rehberi — taksinekadar.com",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "tsx scripts/generate-search-index.ts && astro build && tsx scripts/generate-sitemaps.ts && tsx scripts/audit-internal-links.ts && tsx scripts/generate-build-report.ts",
    "build:astro-only": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:validate-phones": "tsx scripts/validate-phones.ts",
    "data:validate-geography": "tsx scripts/validate-geography.ts",
    "data:normalize": "tsx scripts/normalize-data.ts",
    "data:duplicates": "tsx scripts/detect-duplicates.ts",
    "data:merge": "tsx scripts/merge-data.ts",
    "data:import-osm": "tsx scripts/import-osm.ts",
    "data:import-municipal": "tsx scripts/import-municipal-data.ts",
    "data:report": "tsx scripts/generate-build-report.ts",
    "data:change-report": "tsx scripts/generate-change-report.ts",
    "seo:audit": "tsx scripts/audit-internal-links.ts",
    "seo:search-index": "tsx scripts/generate-search-index.ts",
    "seo:sitemaps": "tsx scripts/generate-sitemaps.ts",
    "indexnow:submit": "tsx scripts/submit-indexnow.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "csv-parse": "7.0.1",
    "csv-stringify": "^6.5.2",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.7.0",
    "gray-matter": "4.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
