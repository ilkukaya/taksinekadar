---
/**
 * Shared ad-slot primitive. The reserved min-height (spec §32/§33: ads must never cause
 * CLS) only matters once an ad will actually load asynchronously and could push content
 * around — with no publisher ID configured, nothing will ever load here, so the slot
 * renders nothing at all rather than leaving a dead gap in the page.
 */
interface Props {
  slotId: string;
  minHeight: string;
  label?: string;
}

const { slotId, minHeight, label = "Reklam alanı" } = Astro.props;
const pubId = import.meta.env.PUBLIC_ADSENSE_PUB_ID;
---

{
  pubId && (
    <div
      class="ad-slot mx-auto w-full max-w-6xl px-4"
      style={`min-height: ${minHeight}`}
      data-ad-slot-id={slotId}
      role="complementary"
      aria-label={label}
    >
      <ins
        class="adsbygoogle"
        style="display:block; width:100%; height:100%;"
        data-ad-client={pubId}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  )
}
