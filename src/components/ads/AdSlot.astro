---
/**
 * Shared ad-slot primitive. Renders only when both the AdSense publisher id and this
 * placement's numeric slot id are configured (see src/config/monetization.ts) — otherwise
 * nothing at all, so the page never shows a dead gap. When it does render, it reserves
 * min-height up front so the asynchronously filled ad can't cause layout shift (CLS).
 */
import { ADSENSE_PUB_ID, AD_SLOT_IDS, type AdPlacement } from "../../config/monetization";

interface Props {
  slotId: AdPlacement;
  minHeight: string;
  label?: string;
  bare?: boolean;
}

const { slotId, minHeight, label = "Reklam alanı", bare = false } = Astro.props;
const adSlot = AD_SLOT_IDS[slotId];
---

{
  ADSENSE_PUB_ID && adSlot && (
    <div
      class:list={["ad-slot", !bare && "mx-auto my-6 w-full max-w-6xl px-4"]}
      data-ad-placement={slotId}
      role="complementary"
      aria-label={label}
    >
      {!bare && (
        <p class="text-ink-400 mb-1 text-center text-[10px] font-semibold tracking-widest uppercase">
          Reklam
        </p>
      )}
      <div style={`min-height: ${minHeight}`}>
        <ins
          class="adsbygoogle"
          style="display:block; width:100%;"
          data-ad-client={ADSENSE_PUB_ID}
          data-ad-slot={adSlot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      </div>
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  )
}
