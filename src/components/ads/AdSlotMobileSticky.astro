---
import AdSlot from "./AdSlot.astro";

const pubId = import.meta.env.PUBLIC_ADSENSE_PUB_ID;
---

{
  pubId && (
    <div class="border-ink-100 fixed inset-x-0 bottom-0 z-10 border-t bg-white md:hidden">
      <AdSlot slotId="mobile-sticky" minHeight="60px" label="Mobil alt reklam alanı" />
    </div>
  )
}
