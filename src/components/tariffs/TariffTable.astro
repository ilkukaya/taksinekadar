---
import type { Tariff } from "../../lib/validation/schemas";
import { buildDistanceReferenceTable } from "../../lib/calculation/fare-calculator";
import { formatCurrencyTRY } from "../../lib/utils/format";

interface Props {
  tariff: Tariff;
}

const { tariff } = Astro.props;
const rows = buildDistanceReferenceTable(tariff);
---

<div class="overflow-x-auto">
  <table class="w-full min-w-[420px] border-collapse text-left text-sm">
    <caption class="sr-only">Mesafeye göre tahmini taksi ücreti</caption>
    <thead>
      <tr class="border-ink-200 text-ink-500 border-b">
        <th scope="col" class="py-2 pr-4 font-medium"> Mesafe </th>
        <th scope="col" class="py-2 font-medium"> Tahmini ücret </th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-ink-100 border-b">
            <td class="text-ink-700 py-2 pr-4">{row.distanceKm} km</td>
            <td class="text-ink-900 py-2 font-semibold">{formatCurrencyTRY(row.estimatedTotal)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
