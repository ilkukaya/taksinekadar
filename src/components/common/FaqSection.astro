---
/**
 * Visible FAQ list + matching FAQPage JSON-LD in one component, so the schema can never
 * drift from the on-page text (Google requires a 1:1 match). Answers are plain text.
 */
import JsonLd from "../structured-data/JsonLd.astro";
import { buildFaqPageSchema, type FaqEntry } from "../../lib/schema/faq-page";

interface Props {
  entries: FaqEntry[];
  title?: string;
  id?: string;
  /** Set false when the page already emits its own FAQPage block. */
  withSchema?: boolean;
}

const { entries, title = "Sık Sorulan Sorular", id = "sss", withSchema = true } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 py-12" id={id} aria-labelledby={`${id}-title`}>
      <p class="eyebrow">Hızlı cevaplar</p>
      <h2 id={`${id}-title`} class="section-title mt-1">
        {title}
      </h2>
      <div class="divide-ink-100 border-ink-100 mt-6 divide-y overflow-hidden rounded-2xl border bg-white">
        {entries.map((entry, index) => (
          <details class="group" open={index === 0}>
            <summary class="text-ink-900 hover:bg-paper flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 font-bold marker:content-none [&::-webkit-details-marker]:hidden">
              <h3 class="text-base font-bold">{entry.question}</h3>
              <span
                class="bg-paper-dim text-ink-600 mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-sm transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="text-ink-700 px-5 pb-5 leading-relaxed">{entry.answer}</p>
          </details>
        ))}
      </div>
      {withSchema && <JsonLd data={buildFaqPageSchema(entries)} />}
    </section>
  )
}
