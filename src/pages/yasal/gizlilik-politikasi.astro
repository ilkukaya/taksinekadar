---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/navigation/Breadcrumb.astro";
import { buildPageMeta } from "../../lib/seo/meta";
import { SITE } from "../../config/site";

const meta = buildPageMeta({
  title: "Gizlilik Politikası",
  description:
    "Taksi Ne Kadar? sitesinin veri toplama, çerez ve reklam uygulamalarına ilişkin gizlilik politikası.",
  path: "/yasal/gizlilik-politikasi/",
  noindex: true,
});
---

<BaseLayout meta={meta}>
  <Breadcrumb
    items={[
      { name: "Ana Sayfa", path: "/" },
      { name: "Gizlilik Politikası", path: "/yasal/gizlilik-politikasi/" },
    ]}
  />

  <section class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-ink-900 text-3xl font-bold">Gizlilik Politikası</h1>

    <h2 class="text-ink-900 mt-8 text-xl font-bold">Topladığımız veriler</h2>
    <p class="text-ink-600 mt-2">
      {SITE.name}, kullanıcı hesabı, üyelik veya profil oluşturmaz; isim, e-posta, telefon veya
      konum bilgisi toplamaz. Taksi ücreti hesaplama aracına girdiğiniz il, mesafe ve süre bilgileri
      yalnızca tarayıcınızda işlenir; sunucularımıza gönderilmez veya kaydedilmez.
    </p>

    <h2 class="text-ink-900 mt-8 text-xl font-bold">Analitik</h2>
    <p class="text-ink-600 mt-2">
      Site trafiğini anlamak için çerezsiz veya minimum veriyle çalışan bir analitik çözümü
      kullanılabilir. Bu araçlar bireysel kullanıcıları tanımlamaz.
    </p>

    <h2 class="text-ink-900 mt-8 text-xl font-bold">Reklamlar</h2>
    <p class="text-ink-600 mt-2">
      Site, gelir modeli olarak görüntülü reklam kullanabilir (ör. Google AdSense). Bu reklam
      sağlayıcıları, kendi gizlilik politikaları kapsamında çerez kullanabilir. Reklam sistemi
      etkinleştirildiğinde, yürürlükteki mevzuatın gerektirdiği asgari onay (consent) mekanizması da
      devreye alınır.
    </p>

    <h2 class="text-ink-900 mt-8 text-xl font-bold">İletişim</h2>
    <p class="text-ink-600 mt-2">
      Gizlilikle ilgili sorularınız için <a
        href="/yasal/iletisim/"
        class="text-ink-800 font-medium underline">iletişim sayfamızdan</a
      > bize ulaşabilirsiniz.
    </p>
  </section>
</BaseLayout>
