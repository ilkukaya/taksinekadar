---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../../components/navigation/Breadcrumb.astro";
import { buildPageMeta, withBrandSuffix } from "../../../../lib/seo/meta";
import { buildCollectionPageSchema } from "../../../../lib/schema/collection-page";
import { canonicalUrl } from "../../../../config/site";
import { getActiveProvinces } from "../../../../lib/repositories/provinces";
import { getDistrictsByProvince } from "../../../../lib/repositories/districts";
import { getTaxiStandsByDistrict } from "../../../../lib/repositories/taxi-stands";
import { locativeOf } from "../../../../lib/language/turkish-suffix";
import { formatPhoneForTel, formatCurrencyTRY } from "../../../../lib/utils/format";
import { getActiveTariff, getProvisionalTariff } from "../../../../lib/repositories/tariffs";
import { calculateFare } from "../../../../lib/calculation/fare-calculator";
import type { Province, District, TaxiStand } from "../../../../lib/validation/schemas";

export function getStaticPaths() {
  const paths: {
    params: { il: string; ilce: string };
    props: { province: Province; district: District; stands: TaxiStand[] };
  }[] = [];
  for (const province of getActiveProvinces()) {
    for (const district of getDistrictsByProvince(province.id)) {
      const stands = getTaxiStandsByDistrict(district.id);
      if (stands.length === 0) continue;
      paths.push({
        params: { il: province.slug, ilce: district.slug },
        props: { province, district, stands },
      });
    }
  }
  return paths;
}

const { province, district, stands } = Astro.props as {
  province: Province;
  district: District;
  stands: TaxiStand[];
};

const sortedStands = [...stands].sort((a, b) => a.name.localeCompare(b.name, "tr"));
const withPhone = stands.filter((s) => s.phonePrimary).length;

const path = `/${province.slug}/${district.slug}/taksi-duraklari/`;
// District names like "Merkez" repeat across many provinces — the province name is always
// included so titles/descriptions stay unique site-wide (spec's duplicate-title build gate).
const title = withBrandSuffix(`${district.name} (${province.name}) Taksi Durakları`);
const description = `${province.name} iline bağlı ${locativeOf(district.name)} ${stands.length} taksi durağının adı, adresi ve telefon numarası (varsa).`;

const meta = buildPageMeta({
  title,
  description,
  path,
  ogImagePath: `/og/${province.slug}.jpg`,
});

const districtTariff =
  getActiveTariff(province.id, "yellow", district.id) ??
  getActiveTariff(province.id, "yellow") ??
  getProvisionalTariff(province.id);
const siblingDistricts = getDistrictsByProvince(province.id)
  .filter((d) => d.id !== district.id)
  .map((d) => ({ d, count: getTaxiStandsByDistrict(d.id).length }))
  .filter(({ count }) => count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);

const standPath = (stand: TaxiStand) => `/${province.slug}/${district.slug}/${stand.slug}/`;

const structuredData = [
  buildCollectionPageSchema({
    name: `${district.name} Taksi Durakları`,
    description,
    path,
    itemList: sortedStands.slice(0, 200).map((s) => ({ name: s.name, path: standPath(s) })),
  }),
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Breadcrumb
    items={[
      { name: "Ana Sayfa", path: "/" },
      { name: "Taksi Durakları", path: "/taksi-duraklari/" },
      { name: province.name, path: `/${province.slug}/taksi-duraklari/` },
      { name: district.name, path },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl leading-tight sm:text-[2.75rem]">
      {district.name}
      <span class="text-ink-400 font-semibold">({province.name})</span> Taksi Durakları
    </h1>
    <p class="text-ink-600 mt-3 text-lg">
      {locativeOf(district.name)} listelenen <strong>{stands.length}</strong> taksi durağı{" "}
      {withPhone > 0 && <>({withPhone} tanesinde telefon numarası mevcut)</>}.
    </p>

    {
      districtTariff && (
        <a
          href={`/${province.slug}-taksi-ucreti/`}
          class="meter mt-6 flex flex-wrap items-center justify-between gap-4 p-5 no-underline"
        >
          <span>
            <span class="text-ink-300 block text-xs font-bold tracking-wider uppercase">
              {locativeOf(district.name)} 10 km taksi
              {districtTariff.status !== "active" && " (tahmini)"}
            </span>
            <span class="meter-digits mt-1 block text-3xl">
              {formatCurrencyTRY(calculateFare(districtTariff, { distanceKm: 10 }).estimatedTotal)}
            </span>
            <span class="text-ink-300 mt-1 block text-xs">
              Açılış {formatCurrencyTRY(districtTariff.openingFee)} · Km{" "}
              {formatCurrencyTRY(districtTariff.pricePerKm)} · İndi-bindi{" "}
              {formatCurrencyTRY(districtTariff.minimumFare)}
            </span>
          </span>
          <span class="btn-primary px-4 py-2.5 text-sm">Ücreti hesapla →</span>
        </a>
      )
    }

    <ul class="mt-8 grid gap-3 md:grid-cols-2">
      {
        sortedStands.map((stand) => (
          <li id={stand.slug} class="card flex flex-col p-4 sm:p-5">
            <a
              href={standPath(stand)}
              class="text-ink-900 text-[1.0625rem] leading-snug font-extrabold hover:underline"
            >
              {stand.name}
            </a>
            {stand.address && <p class="text-ink-600 mt-1 text-sm">{stand.address}</p>}
            <div class="mt-auto flex flex-wrap items-center gap-2 pt-4">
              {stand.phonePrimary && (
                <a
                  href={`tel:${formatPhoneForTel(stand.phonePrimary)}`}
                  class="btn-call px-3.5 py-2 text-sm"
                  aria-label={`${stand.name} ara: ${stand.phonePrimary}`}
                >
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                    <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" />
                  </svg>
                  {stand.phonePrimary}
                </a>
              )}
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(stand.mapQuery ?? stand.name)}`}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="btn-ghost px-3 py-2"
              >
                Haritada ara →
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    {
      siblingDistricts.length > 0 && (
        <section class="mt-12">
          <h2 class="section-title text-2xl sm:text-2xl">
            {province.name} diğer ilçelerdeki taksi durakları
          </h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {siblingDistricts.map(({ d, count }) => (
              <li>
                <a href={`/${province.slug}/${d.slug}/taksi-duraklari/`} class="chip">
                  {d.name} <span class="text-ink-400 ml-1 font-medium">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-8 flex flex-wrap gap-3">
      <a href={`/${province.slug}-taksi-ucreti/`} class="link-arrow">
        {province.name} taksi ücreti sayfasına git →
      </a>
      <a href={`/${province.slug}/taksi-duraklari/`} class="link-arrow">
        {province.name} tüm taksi durakları →
      </a>
    </section>
  </section>
</BaseLayout>
