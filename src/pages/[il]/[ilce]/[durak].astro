---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/navigation/Breadcrumb.astro";
import TariffSummary from "../../../components/tariffs/TariffSummary.astro";
import EstimatedTariffSummary from "../../../components/tariffs/EstimatedTariffSummary.astro";
import { buildPageMeta, withBrandSuffix } from "../../../lib/seo/meta";
import { buildFaqPageSchema, type FaqEntry } from "../../../lib/schema/faq-page";
import { canonicalUrl } from "../../../config/site";
import { getActiveProvinces } from "../../../lib/repositories/provinces";
import { getDistrictsByProvince } from "../../../lib/repositories/districts";
import { getTaxiStandsByDistrict } from "../../../lib/repositories/taxi-stands";
import { getActiveTariff, getProvisionalTariff } from "../../../lib/repositories/tariffs";
import { formatPhoneForTel, formatCurrencyTRY } from "../../../lib/utils/format";
import { locativeOf, relativeLocativeOf } from "../../../lib/language/turkish-suffix";
import type { Province, District, TaxiStand } from "../../../lib/validation/schemas";

const OTHER_STANDS_SHOWN = 8;

export function getStaticPaths() {
  const paths: {
    params: { il: string; ilce: string; durak: string };
    props: { province: Province; district: District; stand: TaxiStand; disambiguator: string };
  }[] = [];

  for (const province of getActiveProvinces()) {
    for (const district of getDistrictsByProvince(province.id)) {
      const stands = getTaxiStandsByDistrict(district.id);
      if (stands.length === 0) continue;

      // A handful of districts have two genuinely different stands sharing the exact same
      // name — sort by slug (stable/unique) and number the 2nd+ occurrence so every page's
      // title/description stays unique (the build fails otherwise, see generate-build-report.ts).
      const byName = new Map<string, TaxiStand[]>();
      for (const s of stands) {
        const group = byName.get(s.name) ?? [];
        group.push(s);
        byName.set(s.name, group);
      }
      for (const group of byName.values()) {
        group.sort((a, b) => a.slug.localeCompare(b.slug));
      }

      for (const stand of stands) {
        const group = byName.get(stand.name)!;
        const index = group.indexOf(stand);
        const disambiguator = index > 0 ? ` ${index + 1}` : "";
        paths.push({
          params: { il: province.slug, ilce: district.slug, durak: stand.slug },
          props: { province, district, stand, disambiguator },
        });
      }
    }
  }
  return paths;
}

const { province, district, stand, disambiguator } = Astro.props as {
  province: Province;
  district: District;
  stand: TaxiStand;
  disambiguator: string;
};

const displayName = `${stand.name}${disambiguator}`;
const path = `/${province.slug}/${district.slug}/${stand.slug}/`;
// district+province are always part of both title and description — never dropped even when
// an address is present — since a generic name+street pattern ("Merkez Taksi Durağı", "No:1")
// can otherwise repeat verbatim across unrelated towns and collide (see build's duplicate check).
const title = withBrandSuffix(`${displayName} — ${district.name}, ${province.name}`);
const description = stand.address
  ? `${displayName} taksi durağı — ${district.name}, ${province.name} — ${stand.address}${stand.phonePrimary ? ` · ${stand.phonePrimary}` : ""}`
  : `${displayName} taksi durağı, ${district.name}, ${province.name}${stand.phonePrimary ? ` · ${stand.phonePrimary}` : ""}`;

const meta = buildPageMeta({ title, description, path });

const standPath = (s: TaxiStand) => `/${province.slug}/${district.slug}/${s.slug}/`;
const mapSearchQuery = stand.mapQuery ?? `${displayName}, ${district.name}, ${province.name}`;
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapSearchQuery)}`;
const yandexMapsUrl = `https://yandex.com/maps/?text=${encodeURIComponent(mapSearchQuery)}`;

const districtStands = getTaxiStandsByDistrict(district.id);
const otherStands = districtStands
  .filter((s) => s.id !== stand.id)
  .sort((a, b) => a.name.localeCompare(b.name, "tr"));
const districtStandCount = districtStands.length;

// A district-specific override (e.g. Alanya/Gazipaşa/Cide) always wins over the province-wide
// figure; a calculator-derived estimate only fills in when there's no verified tariff at all
// for either — see getProvisionalTariff's doc comment. Never presented as verified.
const tariff = getActiveTariff(province.id, "yellow", district.id);
const provisionalTariff = tariff ? undefined : getProvisionalTariff(province.id);
const displayTariff = tariff ?? provisionalTariff;
const tariffLocationName = tariff?.districtId ? district.name : province.name;

const faqs: FaqEntry[] = [
  {
    question: `${displayName} nerede?`,
    answer: stand.address
      ? `${displayName}, ${province.name} iline bağlı ${district.name} ilçesinde, ${stand.address} adresinde yer alır.`
      : `${displayName}, ${province.name} iline bağlı ${district.name} ilçesinde yer alan bir taksi durağıdır.`,
  },
  {
    question: `${displayName} telefon numarası nedir?`,
    answer: stand.phonePrimary
      ? `${displayName} telefon numarası: ${stand.phonePrimary}.`
      : `${displayName} için kayıtlı bir telefon numarası bulunmuyor. Haritadaki konumuna bakabilir veya ${district.name} ilçesindeki diğer duraklarla iletişime geçebilirsiniz.`,
  },
  {
    question: `${locativeOf(district.name)} başka taksi durağı var mı?`,
    answer:
      otherStands.length > 0
        ? `Evet, ${district.name} ilçesinde ${displayName} dışında ${otherStands.length} taksi durağı daha bulunuyor.`
        : `Hayır, ${district.name} ilçesinde kayıtlı tek taksi durağı ${displayName}'dır.`,
  },
];
if (displayTariff) {
  faqs.push({
    question: `${district.name} taksi ücreti ne kadar?`,
    answer: provisionalTariff
      ? `${locativeOf(district.name)} tahmini taksi açılış ücreti ${formatCurrencyTRY(displayTariff.openingFee)}, kilometre ücreti ${formatCurrencyTRY(displayTariff.pricePerKm)} civarındadır; bu rakam resmî bir belediye/UKOME kararıyla ayrıca doğrulanmamıştır.`
      : `${locativeOf(district.name)} güncel taksi açılış ücreti ${formatCurrencyTRY(displayTariff.openingFee)}, kilometre ücreti ${formatCurrencyTRY(displayTariff.pricePerKm)} ve minimum/indi-bindi ücreti ${formatCurrencyTRY(displayTariff.minimumFare)}'dir.`,
  });
}

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "TaxiStand",
    name: displayName,
    url: canonicalUrl(path),
    description: faqs[0]!.answer,
    ...(stand.address && {
      address: {
        "@type": "PostalAddress",
        streetAddress: stand.address,
        addressLocality: district.name,
        addressRegion: province.name,
        addressCountry: "TR",
      },
    }),
    ...(stand.phonePrimary && { telephone: stand.phonePrimary }),
  },
  buildFaqPageSchema(faqs),
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Breadcrumb
    items={[
      { name: "Ana Sayfa", path: "/" },
      { name: "Taksi Durakları", path: "/taksi-duraklari/" },
      { name: province.name, path: `/${province.slug}/taksi-duraklari/` },
      { name: district.name, path: `/${province.slug}/${district.slug}/taksi-duraklari/` },
      { name: displayName, path },
    ]}
  />

  <section class="mx-auto max-w-2xl px-4 py-10">
    <h1 class="text-ink-900 text-3xl font-bold">{displayName}</h1>
    <p class="text-ink-500 mt-1">
      {district.name}, {province.name}
    </p>

    <div class="card mt-6">
      {
        stand.address && (
          <p class="text-ink-700">
            <span class="text-ink-500 text-sm">Adres</span>
            <br />
            {stand.address}
          </p>
        )
      }
      {
        stand.phonePrimary && (
          <p class="mt-4">
            <span class="text-ink-500 text-sm">Telefon</span>
            <br />
            <a
              href={`tel:${formatPhoneForTel(stand.phonePrimary)}`}
              class="text-ink-800 text-lg font-semibold underline"
            >
              {stand.phonePrimary}
            </a>
          </p>
        )
      }
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="text-ink-800 font-medium underline"
        >
          Google Maps'te ara →
        </a>
        <a
          href={yandexMapsUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="text-ink-800 font-medium underline"
        >
          Yandex Haritalar'da ara →
        </a>
      </div>
    </div>

    <section class="mt-10">
      <h2 class="text-ink-900 text-xl font-bold">{displayName} Hakkında</h2>
      <p class="text-ink-700 mt-3 leading-relaxed">
        {
          `${displayName}, ${province.name} ilinin ${district.name} ilçesinde yer alan bir taksi durağıdır.`
        }
        {stand.address && ` ${stand.address} adresinde hizmet vermektedir.`}
        {` ${district.name} ilçesinde, bu durak dahil toplamda `}
        <strong>{districtStandCount}</strong>
        {" taksi durağı bulunmaktadır."}
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-ink-900 text-xl font-bold">{displayName} Nasıl Çağrılır?</h2>
      {
        stand.phonePrimary ? (
          <ol class="text-ink-700 mt-3 list-inside list-decimal space-y-2 leading-relaxed">
            <li>
              Telefonla arayın:{" "}
              <a
                href={`tel:${formatPhoneForTel(stand.phonePrimary)}`}
                class="text-ink-800 font-medium underline"
              >
                {stand.phonePrimary}
              </a>
            </li>
            <li>Bulunduğunuz adresi veya size en yakın belirgin noktayı net şekilde belirtin.</li>
            <li>Size yönlendirilecek taksiyi bekleyin.</li>
          </ol>
        ) : (
          <p class="text-ink-700 mt-3 leading-relaxed">
            Bu durak için kayıtlı bir telefon numarası bulunmuyor. Haritada arayarak konumunu
            görüntüleyebilir veya{" "}
            <a
              href={`/${province.slug}/${district.slug}/taksi-duraklari/`}
              class="text-ink-800 font-medium underline"
            >
              {district.name} ilçesindeki diğer duraklara
            </a>{" "}
            ulaşabilirsiniz.
          </p>
        )
      }
    </section>

    {
      displayTariff && (
        <section class="mt-10">
          <h2 class="text-ink-900 text-xl font-bold">{district.name} Taksi Ücretleri</h2>
          <div class="mt-3">
            {provisionalTariff ? (
              <EstimatedTariffSummary locationName={tariffLocationName} tariff={displayTariff} />
            ) : (
              <TariffSummary locationName={tariffLocationName} tariff={displayTariff} />
            )}
          </div>
          <a
            href={`/${province.slug}-taksi-ucreti/`}
            class="text-ink-800 mt-3 inline-block font-medium underline"
          >
            Mesafeye göre ücret hesapla →
          </a>
        </section>
      )
    }

    <section class="mt-10">
      <h2 class="text-ink-900 text-xl font-bold">
        {relativeLocativeOf(district.name)} Diğer Taksi Durakları
      </h2>
      {
        otherStands.length > 0 ? (
          <>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              {otherStands.slice(0, OTHER_STANDS_SHOWN).map((s) => (
                <a href={standPath(s)} class="card block hover:shadow-sm">
                  <p class="text-ink-900 font-medium">{s.name}</p>
                  {s.phonePrimary && <p class="text-ink-500 mt-1 text-sm">{s.phonePrimary}</p>}
                </a>
              ))}
            </div>
            <a
              href={`/${province.slug}/${district.slug}/taksi-duraklari/`}
              class="text-ink-800 mt-4 inline-block font-medium underline"
            >
              {district.name} ilçesindeki tüm {districtStandCount} durağı gör →
            </a>
          </>
        ) : (
          <p class="text-ink-700 mt-3 leading-relaxed">
            {district.name} ilçesinde kayıtlı başka taksi durağı bulunmuyor — {displayName} bu
            ilçedeki tek kayıtlı durak.
          </p>
        )
      }
    </section>

    <section class="mt-10">
      <h2 class="text-ink-900 text-xl font-bold">Sık Sorulan Sorular</h2>
      <div class="mt-3 space-y-2">
        {
          faqs.map((faq) => (
            <details class="card group">
              <summary class="text-ink-900 flex cursor-pointer list-none items-center justify-between gap-3 font-medium marker:content-none [&::-webkit-details-marker]:hidden">
                <span>{faq.question}</span>
                <span
                  class="text-ink-400 shrink-0 transition-transform group-open:rotate-180"
                  aria-hidden="true"
                >
                  ⌄
                </span>
              </summary>
              <p class="text-ink-600 mt-2 leading-relaxed">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="mt-10 flex flex-col gap-2">
      <a
        href={`/${province.slug}/${district.slug}/taksi-duraklari/`}
        class="text-ink-800 font-medium underline"
      >
        {district.name} ilçesindeki diğer taksi durakları →
      </a>
      <a href={`/${province.slug}-taksi-ucreti/`} class="text-ink-800 font-medium underline">
        {province.name} taksi ücreti sayfasına git →
      </a>
    </section>
  </section>
</BaseLayout>
