---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/navigation/Breadcrumb.astro";
import FareCalculator from "../../components/calculator/FareCalculator.astro";
import SourceNote from "../../components/common/SourceNote.astro";
import UnverifiedNotice from "../../components/common/UnverifiedNotice.astro";
import AdSlotAfterCalculator from "../../components/ads/AdSlotAfterCalculator.astro";
import { buildPageMeta, withBrandSuffix } from "../../lib/seo/meta";
import { canonicalUrl } from "../../config/site";
import { getActiveBusTerminals } from "../../lib/repositories/bus-terminals";
import { getProvinceById } from "../../lib/repositories/provinces";
import { getDistrictById } from "../../lib/repositories/districts";
import { getActiveTariff } from "../../lib/repositories/tariffs";
import { locativeOf } from "../../lib/language/turkish-suffix";
import type { BusTerminal } from "../../lib/validation/schemas";

export function getStaticPaths() {
  return getActiveBusTerminals().map((terminal) => ({
    params: { terminal: terminal.slug },
    props: { terminal },
  }));
}

const { terminal } = Astro.props as { terminal: BusTerminal };
const province = getProvinceById(terminal.provinceId);
const district = getDistrictById(terminal.districtId);
const tariff = province ? getActiveTariff(province.id, "yellow") : undefined;

const path = `/otogar/${terminal.slug}/`;
const title = withBrandSuffix(`${terminal.name} Taksi Ücreti`);
const description = `${terminal.name} ile ${province?.name ?? ""} arasında taksi ücreti bilgisi, il/ilçe konumu ve güncel tarife.`;

const meta = buildPageMeta({ title, description, path });

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonicalUrl(path),
  },
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Breadcrumb
    items={[
      { name: "Ana Sayfa", path: "/" },
      { name: "Otogar", path: "/otogar/" },
      { name: terminal.name, path },
    ]}
  />

  <section class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-ink-900 text-3xl font-bold">{terminal.name} Taksi Ücreti</h1>
    <p class="text-ink-600 mt-3 text-lg">
      {terminal.name}, {province?.name} iline bağlı {district?.name} ilçesinde yer alır.
    </p>

    {
      tariff ? (
        <p class="text-ink-700 mt-4">
          {locativeOf(province?.name ?? "")} güncel taksi tarifesiyle bu otogardan yapılacak
          yolculuğun tahmini ücretini aşağıdaki hesaplama aracıyla öğrenebilirsiniz.
        </p>
      ) : (
        <div class="mt-4">
          <UnverifiedNotice
            message={`${province?.name ?? "Bu il"} için güncel taksi tarifesi henüz doğrulanmadı.`}
          />
        </div>
      )
    }

    <div class="mt-8">
      <FareCalculator preselectedProvinceId={province?.id} />
    </div>
  </section>

  <AdSlotAfterCalculator />

  {
    province && (
      <section class="mx-auto max-w-3xl px-4 py-10">
        <a href={`/${province.slug}-taksi-ucreti/`} class="text-ink-800 font-medium underline">
          {province.name} taksi ücreti sayfasına git →
        </a>
      </section>
    )
  }

  <section class="mx-auto max-w-3xl px-4 pb-10">
    <SourceNote
      sourceName="Belediye / Wikipedia / otogar resmî kaynakları"
      sourceUrl={terminal.sourceUrl}
      lastVerifiedAt={terminal.lastVerifiedAt}
    />
  </section>
</BaseLayout>
