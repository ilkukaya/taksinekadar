---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/navigation/Breadcrumb.astro";
import { buildPageMeta } from "../../lib/seo/meta";
import { buildCollectionPageSchema } from "../../lib/schema/collection-page";
import { getAllProvincesWithStats, getSiteWideTotals } from "../../lib/repositories/stats";

const totals = getSiteWideTotals();
const provincesWithStands = getAllProvincesWithStats()
  .filter((p) => p.activeStandCount > 0)
  .sort((a, b) => a.name.localeCompare(b.name, "tr"));
const provincesWithoutStands = getAllProvincesWithStats()
  .filter((p) => p.activeStandCount === 0)
  .sort((a, b) => a.name.localeCompare(b.name, "tr"));

const meta = buildPageMeta({
  title: "Taksi Durakları",
  description: `Türkiye genelinde ${totals.activeStandCount} taksi durağının telefon ve adres bilgileri, il ve ilçeye göre listelenmiştir.`,
  path: "/taksi-duraklari/",
});

const structuredData = [
  buildCollectionPageSchema({
    name: "Türkiye Taksi Durakları",
    description: "İl ve ilçeye göre taksi durağı dizini.",
    path: "/taksi-duraklari/",
    itemList: provincesWithStands.map((p) => ({
      name: p.name,
      path: `/${p.slug}/taksi-duraklari/`,
    })),
  }),
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Breadcrumb
    items={[
      { name: "Ana Sayfa", path: "/" },
      { name: "Taksi Durakları", path: "/taksi-duraklari/" },
    ]}
  />

  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-ink-900 text-3xl font-bold">Taksi Durakları</h1>
    <p class="text-ink-600 mt-3 max-w-2xl text-lg">
      Türkiye genelinde <strong>{totals.activeStandCount}</strong> taksi durağının adı, adresi ve (varsa)
      telefon numarası; il seçip ardından ilçeye göre listelenir. Kaynak ve doğrulama yöntemi için <a
        href="/yasal/veri-kaynaklari/"
        class="underline">veri kaynakları</a
      >
      sayfasına bakın.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
      {
        provincesWithStands.map((province) => (
          <a href={`/${province.slug}/taksi-duraklari/`} class="card block hover:shadow-md">
            <p class="text-ink-900 font-semibold">{province.name}</p>
            <p class="text-ink-500 mt-1 text-sm">{province.activeStandCount} durak</p>
          </a>
        ))
      }
    </div>

    {
      provincesWithoutStands.length > 0 && (
        <section class="mt-10">
          <h2 class="text-ink-900 text-lg font-semibold">Henüz durak verisi olmayan iller</h2>
          <p class="text-ink-500 mt-2 text-sm">
            {provincesWithoutStands.map((p) => p.name).join(", ")}
          </p>
        </section>
      )
    }
  </section>
</BaseLayout>
