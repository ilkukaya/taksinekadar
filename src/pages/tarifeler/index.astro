---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/navigation/Breadcrumb.astro";
import { buildPageMeta } from "../../lib/seo/meta";
import { getAllProvincesWithStats } from "../../lib/repositories/stats";

const provinces = [...getAllProvincesWithStats()].sort((a, b) =>
  a.name.localeCompare(b.name, "tr"),
);
const verified = provinces.filter((p) => p.hasVerifiedTariff);
const unverified = provinces.filter((p) => !p.hasVerifiedTariff);

const meta = buildPageMeta({
  title: "Türkiye Taksi Tarifeleri — İl İl Güncel Ücretler",
  description:
    "Türkiye genelinde il il güncel taksi tarifeleri: açılış ücreti, kilometre ücreti ve indi-bindi ücreti. Kaynağı doğrulanmış tarifeler ayrı listelenir.",
  path: "/tarifeler/",
});
---

<BaseLayout meta={meta}>
  <Breadcrumb
    items={[
      { name: "Ana Sayfa", path: "/" },
      { name: "Tarifeler", path: "/tarifeler/" },
    ]}
  />

  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-ink-900 text-3xl font-bold">Türkiye Taksi Tarifeleri</h1>
    <p class="text-ink-600 mt-3 max-w-2xl text-lg">
      İl bazında güncel taksi tarifelerine buradan ulaşabilirsiniz. Her sayfada tarifenin kaynağı ve
      yürürlük tarihi belirtilir.
    </p>

    <h2 class="text-ink-900 mt-10 text-xl font-bold">
      Kaynağı Doğrulanmış Tarifeler ({verified.length})
    </h2>
    <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
      {
        verified.map((p) => (
          <li>
            <a
              href={`/${p.slug}-taksi-ucreti/`}
              class="text-ink-700 hover:text-ink-900 hover:underline"
            >
              {p.name}
            </a>
          </li>
        ))
      }
    </ul>

    {
      unverified.length > 0 && (
        <>
          <h2 class="text-ink-900 mt-12 text-xl font-bold">
            Doğrulama Bekleyen İller ({unverified.length})
          </h2>
          <p class="text-ink-500 mt-2 text-sm">
            Bu illerde güncel tarife için henüz güvenilir bir kaynak doğrulayamadık; sayfaları
            ziyaret edildiğinde bu açıkça belirtilir.
          </p>
          <ul class="text-ink-500 mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
            {unverified.map((p) => (
              <li>
                <a href={`/${p.slug}-taksi-ucreti/`} class="hover:text-ink-700 hover:underline">
                  {p.name}
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</BaseLayout>
