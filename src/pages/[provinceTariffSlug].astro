---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/navigation/Breadcrumb.astro";
import FareCalculator from "../components/calculator/FareCalculator.astro";
import TariffTable from "../components/tariffs/TariffTable.astro";
import TariffSummary from "../components/tariffs/TariffSummary.astro";
import EstimatedTariffSummary from "../components/tariffs/EstimatedTariffSummary.astro";
import UnverifiedNotice from "../components/common/UnverifiedNotice.astro";
import SourceNote from "../components/common/SourceNote.astro";
import AdSlotAfterCalculator from "../components/ads/AdSlotAfterCalculator.astro";
import AdSlotInContent from "../components/ads/AdSlotInContent.astro";
import TariffStats from "../components/tariffs/TariffStats.astro";
import FaqSection from "../components/common/FaqSection.astro";
import PartnerOffers from "../components/monetization/PartnerOffers.astro";
import { getTaxiStandsByDistrict } from "../lib/repositories/taxi-stands";
import { calculateFare } from "../lib/calculation/fare-calculator";
import { buildPageMeta, withBrandSuffix } from "../lib/seo/meta";
import { canonicalUrl } from "../config/site";
import { getActiveProvinces } from "../lib/repositories/provinces";
import { getDistrictsByProvince } from "../lib/repositories/districts";
import {
  getAllActiveTariffsForProvince,
  getTariffHistoryForProvince,
  getProvisionalTariff,
} from "../lib/repositories/tariffs";
import { getAirportsByProvince } from "../lib/repositories/airports";
import { getBusTerminalsByProvince } from "../lib/repositories/bus-terminals";
import { getAllProvincesWithStats } from "../lib/repositories/stats";
import { formatCurrencyTRY, formatDateTR } from "../lib/utils/format";
import { locativeOf } from "../lib/language/turkish-suffix";
import { VEHICLE_TYPE_LABELS } from "../config/vehicle-types";
import type { Province } from "../lib/validation/schemas";

export function getStaticPaths() {
  return getActiveProvinces().map((province) => ({
    params: { provinceTariffSlug: `${province.slug}-taksi-ucreti` },
    props: { province },
  }));
}

const { province } = Astro.props as { province: Province };

const districts = getDistrictsByProvince(province.id);
const districtById = new Map(districts.map((d) => [d.id, d]));

const allTariffs = getAllActiveTariffsForProvince(province.id);
const provinceWideTariffs = allTariffs.filter((t) => !t.districtId);
const districtTariffs = allTariffs.filter((t) => t.districtId);
const history = getTariffHistoryForProvince(province.id);
const airports = getAirportsByProvince(province.id);
const busTerminals = getBusTerminalsByProvince(province.id);

const hasAnyVerifiedTariff = provinceWideTariffs.length > 0 || districtTariffs.length > 0;
const primaryTariff =
  provinceWideTariffs.find((t) => t.vehicleType === "yellow") ?? provinceWideTariffs[0];
// Only reached when there's no verified province-wide tariff — a lower-confidence,
// calculator-derived estimate, shown distinctly (see EstimatedTariffSummary) rather than
// left blank. Never counted toward hasAnyVerifiedTariff / hasVerifiedTariff.
const provisionalTariff = primaryTariff ? undefined : getProvisionalTariff(province.id);
const displayTariff = primaryTariff ?? provisionalTariff;
const displayTariffs =
  provinceWideTariffs.length > 0
    ? provinceWideTariffs
    : provisionalTariff
      ? [provisionalTariff]
      : [];
const hasAnyDisplayableTariff = hasAnyVerifiedTariff || !!provisionalTariff;

const sameRegionProvinces = getAllProvincesWithStats()
  .filter((p) => p.region === province.region && p.id !== province.id)
  .sort((a, b) => a.name.localeCompare(b.name, "tr"))
  .slice(0, 12);

const path = `/${province.slug}-taksi-ucreti/`;
const title = withBrandSuffix(`${province.name} Taksi Ücreti Ne Kadar?`);
const description = displayTariff
  ? primaryTariff
    ? `${province.name} taksi ücreti: açılış ${formatCurrencyTRY(displayTariff.openingFee)}, km ${formatCurrencyTRY(displayTariff.pricePerKm)}, indi-bindi ${formatCurrencyTRY(displayTariff.minimumFare)}. Tarife ${formatDateTR(displayTariff.validFrom)} tarihinde yürürlüğe girmiştir.`
    : `${province.name} taksi ücreti (tahmini): açılış ${formatCurrencyTRY(displayTariff.openingFee)}, km ${formatCurrencyTRY(displayTariff.pricePerKm)}, indi-bindi ${formatCurrencyTRY(displayTariff.minimumFare)} civarındadır.`
  : `${province.name} için güncel taksi tarifesi henüz doğrulanmadı. Resmî kaynaklardan doğrulama sağlandığında bu sayfa güncellenecektir.`;

const meta = buildPageMeta({
  title,
  description,
  path,
  noindex: !hasAnyDisplayableTariff,
  ogImagePath: `/og/${province.slug}.jpg`,
  ogImageAlt: `${province.name} taksi ücreti`,
});

const districtsWithStands = districts
  .map((district) => ({ district, count: getTaxiStandsByDistrict(district.id).length }))
  .filter(({ count }) => count > 0)
  .sort((a, b) => b.count - a.count);
const totalStands = districtsWithStands.reduce((sum, d) => sum + d.count, 0);

const loc = locativeOf(province.name);
const isEstimateOnly = !primaryTariff && !!provisionalTariff;
const faqEntries = displayTariff
  ? [
      {
        question: `${loc} taksi açılış ücreti ne kadar?`,
        answer: isEstimateOnly
          ? `${loc} taksi açılış ücreti tahmini olarak ${formatCurrencyTRY(displayTariff.openingFee)} civarındadır. Bu rakam resmî bir belediye/UKOME kararıyla ayrıca doğrulanmamıştır.`
          : `${loc} güncel taksi açılış ücreti ${formatCurrencyTRY(displayTariff.openingFee)}'dir. Tarife ${formatDateTR(displayTariff.validFrom)} tarihinde yürürlüğe girmiştir.`,
      },
      {
        question: `${loc} taksi km ücreti ne kadar?`,
        answer: `${loc} taksi kilometre ücreti ${isEstimateOnly ? "tahmini olarak " : ""}${formatCurrencyTRY(displayTariff.pricePerKm)}'dir. Açılış ücretine her kilometre için bu tutar eklenir.`,
      },
      {
        question: `${loc} indi-bindi (minimum) taksi ücreti ne kadar?`,
        answer: `${loc} indi-bindi ücreti ${isEstimateOnly ? "tahmini olarak " : ""}${formatCurrencyTRY(displayTariff.minimumFare)}'dir. Kısa yolculuklarda taksimetre bu tutarın altında kalsa bile minimum ücret ödenir.`,
      },
      {
        question: `${loc} 10 km taksi ne kadar tutar?`,
        answer: `${loc} 10 km'lik bir taksi yolculuğu, bekleme ve köprü/otoyol ücreti hariç yaklaşık ${formatCurrencyTRY(calculateFare(displayTariff, { distanceKm: 10 }).estimatedTotal)} tutar. 5 km yaklaşık ${formatCurrencyTRY(calculateFare(displayTariff, { distanceKm: 5 }).estimatedTotal)}, 20 km ise yaklaşık ${formatCurrencyTRY(calculateFare(displayTariff, { distanceKm: 20 }).estimatedTotal)} tutar.`,
      },
      ...(totalStands > 0
        ? [
            {
              question: `${loc} kaç taksi durağı var?`,
              answer: `Sitemizde ${province.name} genelinde ${districtsWithStands.length} ilçede toplam ${totalStands} taksi durağı telefon ve adres bilgisiyle listelenmektedir. En çok durak ${districtsWithStands[0]!.district.name} ilçesindedir (${districtsWithStands[0]!.count} durak).`,
            },
          ]
        : []),
    ]
  : [];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonicalUrl(path),
    inLanguage: "tr-TR",
    ...(displayTariff ? { dateModified: displayTariff.lastVerifiedAt } : {}),
    about: { "@type": "AdministrativeArea", name: province.name, containedInPlace: "Türkiye" },
  },
];
---

<BaseLayout meta={meta} structuredData={structuredData}>
  <Breadcrumb
    items={[
      { name: "Ana Sayfa", path: "/" },
      { name: "Tarifeler", path: "/tarifeler/" },
      { name: `${province.name} Taksi Ücreti`, path },
    ]}
  />

  <section class="mx-auto max-w-6xl px-4 pt-6 pb-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="eyebrow">
          {province.region} Bölgesi · {String(province.plateCode).padStart(2, "0")}
        </p>
        <h1 class="mt-2 text-3xl leading-tight sm:text-5xl">
          {province.name} Taksi Ücreti Ne Kadar?
        </h1>
      </div>
    </div>

    <div class="mt-4 max-w-3xl">
      {
        primaryTariff ? (
          <TariffSummary locationName={province.name} tariff={primaryTariff} />
        ) : provisionalTariff ? (
          <EstimatedTariffSummary locationName={province.name} tariff={provisionalTariff} />
        ) : (
          <UnverifiedNotice message={`${province.name} için güncel tarife henüz doğrulanmadı.`} />
        )
      }
    </div>

    {
      displayTariff && (
        <div class="mt-6">
          <TariffStats tariff={displayTariff} isEstimate={isEstimateOnly} />
        </div>
      )
    }

    <nav class="mt-6 flex flex-wrap gap-2 text-sm" aria-label="Sayfa içi bağlantılar">
      <a href="#hesapla" class="chip">Ücret hesapla</a>
      {
        displayTariff && (
          <a href="#mesafe" class="chip">
            Mesafeye göre ücret
          </a>
        )
      }
      {
        totalStands > 0 && (
          <a href="#duraklar" class="chip">
            Taksi durakları ({totalStands})
          </a>
        )
      }
      {
        faqEntries.length > 0 && (
          <a href="#sss" class="chip">
            Sık sorulanlar
          </a>
        )
      }
    </nav>

    <div class="mt-8" id="hesapla">
      <FareCalculator
        preselectedProvinceId={province.id}
        heading={`${province.name} taksi ücreti hesapla`}
      />
    </div>
  </section>

  <AdSlotAfterCalculator />

  {
    displayTariffs.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-10">
        <h2 class="section-title">{province.name} Taksi Tarife Tablosu</h2>
        <div class="border-ink-100 mt-4 overflow-x-auto rounded-2xl border bg-white px-4">
          <table class="w-full min-w-[480px] border-collapse text-left text-sm">
            <thead>
              <tr class="border-ink-200 text-ink-500 border-b">
                <th scope="col" class="py-2 pr-4 font-medium">
                  Araç türü
                </th>
                <th scope="col" class="py-2 pr-4 font-medium">
                  Açılış
                </th>
                <th scope="col" class="py-2 pr-4 font-medium">
                  Km ücreti
                </th>
                <th scope="col" class="py-2 pr-4 font-medium">
                  İndi-bindi
                </th>
                <th scope="col" class="py-2 font-medium">
                  Bekleme (dk)
                </th>
              </tr>
            </thead>
            <tbody>
              {displayTariffs.map((t) => (
                <tr class="border-ink-100 border-b">
                  <td class="text-ink-800 py-2 pr-4 font-medium">
                    {VEHICLE_TYPE_LABELS[t.vehicleType]}
                  </td>
                  <td class="text-ink-600 py-2 pr-4">{formatCurrencyTRY(t.openingFee)}</td>
                  <td class="text-ink-600 py-2 pr-4">{formatCurrencyTRY(t.pricePerKm)}</td>
                  <td class="text-ink-600 py-2 pr-4">{formatCurrencyTRY(t.minimumFare)}</td>
                  <td class="text-ink-600 py-2">
                    {t.waitingFeePerMinute ? formatCurrencyTRY(t.waitingFeePerMinute) : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    displayTariff && (
      <section class="mx-auto max-w-3xl px-4 py-10" id="mesafe">
        <h2 class="section-title">Mesafeye Göre Tahmini Ücret</h2>
        <p class="text-ink-600 mt-1">
          {locativeOf(province.name)}{" "}
          {VEHICLE_TYPE_LABELS[displayTariff.vehicleType].toLocaleLowerCase("tr-TR")} için mesafeye
          göre tahmini ücretler:
        </p>
        <div class="mt-4">
          <TariffTable tariff={displayTariff} />
        </div>
      </section>
    )
  }

  <AdSlotInContent />

  {
    districtTariffs.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-10">
        <h2 class="section-title">İlçe Bazında Farklı Tarife</h2>
        <p class="text-ink-600 mt-1">
          Bazı ilçelerde il genelinden farklı, ayrıca doğrulanmış bir tarife uygulanabilir:
        </p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {districtTariffs.map((t) => {
            const district = t.districtId ? districtById.get(t.districtId) : undefined;
            return (
              <div class="card">
                <p class="text-ink-900 font-semibold">{district?.name ?? t.districtId}</p>
                <p class="text-ink-600 mt-1 text-sm">
                  Açılış {formatCurrencyTRY(t.openingFee)} · Km {formatCurrencyTRY(t.pricePerKm)} ·
                  İndi-bindi {formatCurrencyTRY(t.minimumFare)}
                </p>
                <div class="mt-2">
                  <SourceNote
                    sourceName={t.sourceName}
                    sourceUrl={t.sourceUrl}
                    lastVerifiedAt={t.lastVerifiedAt}
                  />
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  {
    totalStands > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-10" id="duraklar">
        <h2 class="section-title">{province.name} Taksi Durakları</h2>
        <p class="text-ink-600 mt-2">
          {province.name} genelinde {districtsWithStands.length} ilçede{" "}
          <strong>{totalStands}</strong> taksi durağının telefon ve adresi listeleniyor. En çok
          durak bulunan ilçeler:
        </p>
        <ul class="mt-5 grid gap-2 sm:grid-cols-2">
          {districtsWithStands.slice(0, 8).map(({ district, count }) => (
            <li>
              <a
                href={`/${province.slug}/${district.slug}/taksi-duraklari/`}
                class="card-link border-ink-100 flex items-center justify-between rounded-2xl border bg-white px-4 py-3"
              >
                <span class="text-ink-900 font-bold">{district.name}</span>
                <span class="text-ink-500 text-sm">{count} durak →</span>
              </a>
            </li>
          ))}
        </ul>
        <a href={`/${province.slug}/taksi-duraklari/`} class="btn-dark mt-5">
          {province.name} tüm taksi durakları
        </a>
      </section>
    )
  }

  <PartnerOffers
    kinds={airports.length > 0
      ? ["airportTransfer", "carRental", "hotel"]
      : ["carRental", "hotel", "busTicket"]}
    place={province.name}
    title={`${province.name} yolculuğunu planla`}
  />

  <section class="mx-auto max-w-3xl px-4 py-10">
    <h2 class="section-title">İndi-Bindi ve Bekleme Ücreti</h2>
    <p class="text-ink-600 mt-2">
      "İndi-bindi ücreti", bir yolculukta ödenecek minimum tutardır; hesaplanan tutar bu seviyenin
      altında kalırsa yolcudan minimum ücret tahsil edilir.
    </p>
    <a
      href="/rehber/taksi-indi-bindi-ucreti-nedir/"
      class="text-ink-800 mt-2 inline-block font-medium underline"
    >
      İndi-bindi ücreti hakkında ayrıntılı bilgi →
    </a>
  </section>

  {
    history.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-10">
        <h2 class="section-title">Geçmiş Tarife Özeti</h2>
        <ul class="mt-4 space-y-3">
          {history.map((t) => (
            <li class="card">
              <p class="text-ink-700 text-sm">
                {formatDateTR(t.validFrom)} –{" "}
                {t.validUntil ? formatDateTR(t.validUntil) : "belirsiz"}: açılış{" "}
                {formatCurrencyTRY(t.openingFee)}, km {formatCurrencyTRY(t.pricePerKm)}, indi-bindi{" "}
                {formatCurrencyTRY(t.minimumFare)}
              </p>
              <div class="mt-1">
                <SourceNote sourceName={t.sourceName} sourceUrl={t.sourceUrl} />
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    primaryTariff && (
      <section class="mx-auto max-w-3xl px-4 pb-4">
        <SourceNote
          sourceName={primaryTariff.sourceName}
          sourceUrl={primaryTariff.sourceUrl}
          lastVerifiedAt={primaryTariff.lastVerifiedAt}
        />
      </section>
    )
  }

  {
    (airports.length > 0 || busTerminals.length > 0) && (
      <section class="mx-auto max-w-3xl px-4 py-10">
        <h2 class="section-title">Havalimanı ve Otogar</h2>
        <ul class="mt-4 space-y-2">
          {airports.map((a) => (
            <li>
              <a href={`/havalimani/${a.slug}/`} class="text-ink-800 font-medium hover:underline">
                {a.name}
              </a>
            </li>
          ))}
          {busTerminals.map((b) => (
            <li>
              <a href={`/otogar/${b.slug}/`} class="text-ink-800 font-medium hover:underline">
                {b.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <FaqSection
    entries={faqEntries}
    title={`${province.name} Taksi Ücreti Hakkında Sık Sorulanlar`}
  />

  <section class="mx-auto max-w-3xl px-4 py-10">
    <h2 class="section-title">İlgili Rehberler</h2>
    <ul class="text-ink-700 mt-4 list-inside list-disc space-y-1">
      <li>
        <a href="/rehber/taksi-ucreti-nasil-hesaplanir/" class="hover:text-ink-900 underline">
          Taksi ücreti nasıl hesaplanır?
        </a>
      </li>
      <li>
        <a href="/rehber/taksi-acilis-ucreti-nedir/" class="hover:text-ink-900 underline">
          Taksi açılış ücreti nedir?
        </a>
      </li>
      <li>
        <a href="/rehber/gece-tarifesi-var-mi/" class="hover:text-ink-900 underline">
          Gece tarifesi var mı?
        </a>
      </li>
    </ul>
  </section>

  {
    sameRegionProvinces.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-10">
        <h2 class="section-title">{province.region} Bölgesindeki Diğer İller</h2>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {sameRegionProvinces.map((p) => (
            <li>
              <a
                href={`/${p.slug}-taksi-ucreti/`}
                class="text-ink-700 hover:text-ink-900 hover:underline"
              >
                {p.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
