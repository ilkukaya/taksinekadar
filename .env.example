# Google AdSense publisher ID. Set this as a Netlify environment variable (Site
# configuration → Environment variables), not just locally — Netlify builds the site.
# Leave unset in development: ad slots render as empty reserved space (no CLS) and no ad
# script loads until this is configured.
PUBLIC_ADSENSE_PUB_ID=

# IndexNow key for `pnpm indexnow:submit` (run manually after a deploy, or wire up your own
# automation later). Leave unset to skip submission — it's optional, not a build requirement.
INDEXNOW_KEY=

# Local path to a Geofabrik Turkey PBF extract, used only by scripts/import-osm.ts (Phase 2).
OSM_PBF_PATH=
