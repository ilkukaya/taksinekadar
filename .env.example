# Google AdSense publisher ID. Leave unset in development — ad slots render as empty
# reserved space (no CLS) and no ad script loads until this is configured.
PUBLIC_ADSENSE_PUB_ID=

# IndexNow key for notifying search engines of changed URLs. Leave unset to skip submission.
INDEXNOW_KEY=

# Netlify CLI deploy credentials (used by GitHub Actions, not needed for local dev).
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Local path to a Geofabrik Turkey PBF extract, used only by scripts/import-osm.ts (Phase 2).
OSM_PBF_PATH=
