# Bu değişkenleri Netlify'da ayarlayın: Site configuration → Environment variables.
# Boş bırakılan her entegrasyon sitede hiçbir şey göstermez (sahte kimlik yok, boş reklam kutusu yok).
# Ayrıntılı kurulum: docs/YAYIN-VE-GELIR-REHBERI.md

# --- Alan adı / canonical -------------------------------------------------------------
# Boş bırakılırsa Netlify'ın birincil adresi (URL) kullanılır; özel alan adı bağlandığında
# otomatik olarak ona geçer. Yalnızca özel bir durum varsa doldurun.
SITE_URL=
# İletişim sayfasında görünen e-posta (alan adına e-posta yönlendirmesi kurulana kadar).
PUBLIC_CONTACT_EMAIL=

# --- Arama motoru doğrulama ---------------------------------------------------------------
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=

# --- Analitik ------------------------------------------------------------------------------
# Cloudflare Web Analytics (ücretsiz, çerezsiz) beacon token'ı
PUBLIC_CF_BEACON_TOKEN=
# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX), isteğe bağlı
PUBLIC_GA4_ID=

# --- Google AdSense -----------------------------------------------------------------------
# Yayıncı kimliği (ca-pub-XXXXXXXXXXXXXXXX). Tek başına Otomatik Reklamlar'ı açar.
PUBLIC_ADSENSE_PUB_ID=
# İsteğe bağlı: AdSense panelinde oluşturduğunuz reklam birimlerinin sayısal "data-ad-slot" kimlikleri.
PUBLIC_ADSENSE_SLOT_AFTER_CALCULATOR=
PUBLIC_ADSENSE_SLOT_IN_CONTENT=
PUBLIC_ADSENSE_SLOT_MOBILE_STICKY=
PUBLIC_ADSENSE_SLOT_HEADER=
PUBLIC_ADSENSE_SLOT_BETWEEN_CARDS=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_FOOTER=

# --- İş ortağı (affiliate) bağlantıları ------------------------------------------------------
# Tam takip bağlantısı (affiliate ağından aldığınız URL) + kartta görünecek kısa ad.
PUBLIC_AFFILIATE_TRANSFER_URL=
PUBLIC_AFFILIATE_TRANSFER_NAME=
PUBLIC_AFFILIATE_CAR_RENTAL_URL=
PUBLIC_AFFILIATE_CAR_RENTAL_NAME=
PUBLIC_AFFILIATE_HOTEL_URL=
PUBLIC_AFFILIATE_HOTEL_NAME=
PUBLIC_AFFILIATE_BUS_URL=
PUBLIC_AFFILIATE_BUS_NAME=

# --- IndexNow (Bing/Yandex'e anında bildirim) -----------------------------------------------
# `pnpm indexnow:submit` için. 8-128 karakterlik rastgele harf/rakam dizisi.
INDEXNOW_KEY=

# Yerel OSM PBF yolu (yalnızca scripts/import-osm.ts için).
OSM_PBF_PATH=
